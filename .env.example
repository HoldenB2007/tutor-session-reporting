# Copy to .env for local development. Railway injects these as service variables.
SECRET_KEY=change-me
DEBUG=1
# Leave DATABASE_URL unset locally to use SQLite; Railway provides a Postgres URL.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SHOW_DEMO_CREDENTIALS=1
STAFF_CONTACT_EMAIL=info@lvaep.org
